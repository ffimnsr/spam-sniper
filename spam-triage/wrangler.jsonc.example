{
	"name": "spam-triage",
	"main": "worker/index.ts",
	"compatibility_date": "2025-05-28",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spam-triage-db",
			"database_id": ""
		}
	],
	"vars": {
		"HIDDEN_ADMIN_PATH": "/replace-with-random-chars",
		"ENVIRONMENT": "production"
	},
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 0 * * *"
		]
	}
}
