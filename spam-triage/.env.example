# Frontend build variables. Vite inlines VITE_* values into the public bundle.
# Cloudflare Turnstile test sitekey; replace for production builds.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_HIDDEN_ADMIN_PATH=/f4c9
