HASH_SECRET=dev-hash-secret-change-me-in-production
HASH_SECRET_PREVIOUS=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
HIDDEN_ADMIN_PATH=/f4c9
# Cloudflare Access issuer host (no scheme).
ACCESS_TEAM_DOMAIN=dev.cloudflareaccess.com
# Any value works locally because the Access check is bypassed on local hosts.
ACCESS_AUD=dev-application-audience
# Local-only bypass for Cloudflare Access and Turnstile action/hostname checks.
ENVIRONMENT=development
