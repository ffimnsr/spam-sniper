{
  "name": "spam-triage",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spam-triage-db",
      "database_id": "ac4e5b27-86b4-4d34-b308-43b7f625d051"
    }
  ],
  "vars": {
    "HIDDEN_ADMIN_PATH": "/f4c9",
    "ENVIRONMENT": "production"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
