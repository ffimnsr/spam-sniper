{
  "name": "spam-triage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "spam-sniper-triage.vastorigins.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spam-triage-db",
      "database_id": "ac4e5b27-86b4-4d34-b308-43b7f625d051"
    }
  ],
  "vars": {
    "HIDDEN_ADMIN_PATH": "/f4c9",
    "ACCESS_TEAM_DOMAIN": "ifn4.cloudflareaccess.com",
    // Application Audience (AUD) tag from the Access app covering /f4c9 and
    // /api/f4c9/*. If this is stale or wrong, admin API calls fail closed (401).
    "ACCESS_AUD": "dffaab39410f20005e6d17ba79125f92c7325cacd9aecdc7cfc24acfc73f070a",
    "ENVIRONMENT": "production"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER_WRITE",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER_READ",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *", "10 0 * * *", "20 0 * * *"]
  }
}
